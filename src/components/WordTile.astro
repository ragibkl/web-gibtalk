---
// A word as the app shows it: a picture with its label, yellow for a folder
// (a word with more words inside) and green for a word.
import type { Word } from "../lib/templates";

interface Props {
  word: Word;
}

const { word } = Astro.props;
const isFolder = (word.children?.length ?? 0) > 0;
---

<figure class:list={["tile", isFolder ? "folder" : "word"]}>
  {word.uri ? (
    <img src={word.uri} alt="" loading="lazy" width="96" height="96" />
  ) : (
    <span class="no-image" aria-hidden="true" />
  )}
  <figcaption>{word.label}</figcaption>
</figure>

<style>
  .tile {
    margin: 0;
    width: 7.5rem;
    padding: 0.5rem;
    border: 3px solid var(--border);
    border-radius: 12px;
    text-align: center;
    color: #141414;
  }
  .folder {
    background: var(--folder);
  }
  .word {
    background: var(--word);
  }
  img,
  .no-image {
    display: block;
    width: 96px;
    height: 96px;
    margin: 0 auto;
    object-fit: contain;
    background: #ffffff;
    border: 2px solid #141414;
    border-radius: 6px;
  }
  figcaption {
    margin-top: 0.35rem;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
</style>
